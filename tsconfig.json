{
  "compilerOptions": {
    "target": "es6",
    "module": "esnext",
    "declaration": true,
    "lib": ["ESNext", "DOM"],
    "jsx": "react",
    "sourceMap": true,
    "strict": false,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "outDir": "./",
    "typeRoots": ["node_modules/@types"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "exclude": [],
  "include": ["./**/*"]
}
